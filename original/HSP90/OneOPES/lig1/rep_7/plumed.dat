################################################
#  plumed.dat for Funnel MetaD in the WTE + PT #
################################################
RESTART

#################################################
### DEFINE RADIUS + CALC PROT-LIG VECTOR COMP ###
#################################################
MOLINFO STRUCTURE=../whole.pdb
protein: GROUP ATOMS=33-3299
ligand: GROUP ATOMS=1-32
WHOLEMOLECULES STRIDE=1 ENTITY0=protein ENTITY1=ligand
WRAPAROUND ATOMS=ligand AROUND=2629 GROUPBY=32 #random CA close to the binding pocket VAL171

##########################
### DEFINITION_OF_COMs ###
##########################
lig: COM ATOMS=ligand
p0: COM ATOMS=1053,1072,1227,1241,2607,2645,2073,2629,2645
p1: COM ATOMS=556,575,594,605,619,630,1398,1410,1908,2103,2138,2593,2607,2629

WO: GROUP ATOMS=3300-46770:3

# Protein atoms to solvate
P1: GROUP ATOMS=612  #ND2 ASN    36
P2: GROUP ATOMS=1283  #OD2 ASP    78
P3: GROUP ATOMS=1405  #OD2 ASP    87
P4: GROUP ATOMS=2601  #OG1 THR   169

NP1: COORDINATION GROUPA=P1  GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.25 NN=6 MM=10 D_MAX=0.6} NLIST NL_CUTOFF=2.0 NL_STRIDE=20
NP2: COORDINATION GROUPA=P2  GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.25 NN=6 MM=10 D_MAX=0.6} NLIST NL_CUTOFF=2.0 NL_STRIDE=20
NP3: COORDINATION GROUPA=P3  GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.25 NN=6 MM=10 D_MAX=0.6} NLIST NL_CUTOFF=2.0 NL_STRIDE=20
NP4: COORDINATION GROUPA=P4  GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.25 NN=6 MM=10 D_MAX=0.6} NLIST NL_CUTOFF=2.0 NL_STRIDE=20

# Ligand atoms to solvate
G1: GROUP ATOMS=1  #N1  MOL   210
G2: GROUP ATOMS=19  #S1  MOL   210

NG1: COORDINATION GROUPA=G1 GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.25 NN=6 MM=10 D_MAX=0.6} NLIST NL_CUTOFF=2.0 NL_STRIDE=20
NG2: COORDINATION GROUPA=G2 GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.25 NN=6 MM=10 D_MAX=0.6} NLIST NL_CUTOFF=2.0 NL_STRIDE=20

#########################
### DEFINITION_OF_CVs ###
#########################

##############################
pp: PROJECTION_ON_AXIS AXIS_ATOMS=p0,p1 ATOM=lig

################
#RMSD WALLS ####
################
rmsd_protCA: RMSD REFERENCE=../prot_rmsd.pdb TYPE=OPTIMAL
uwall_rmsd_protCA: UPPER_WALLS ARG=rmsd_protCA AT=0.25 KAPPA=200000

##########################
### CMAP #################
##########################
INCLUDE FILE=../cmap.dat

##########################
# Stiff lig torsions #####
##########################
lig_torsion1: TORSION ATOMS=3,1,2,5
lig_torsion2: TORSION ATOMS=1,2,5,9

#########################
### FUNNEL_PARAMETERS ###
#########################
s_cent: CONSTANT VALUES=2.0                                    # INFLEXION
beta_cent: CONSTANT VALUES=0.5                                 # STEEPNESS
wall_width: CONSTANT VALUES=0.1                                # WIDTH (h)
wall_buffer: CONSTANT VALUES=0.25                              # BUFFER (f, total width = WIDTH + BUFFER)
lwall: LOWER_WALLS ARG=pp.proj AT=1.0 KAPPA=20000.0            # Lower Wall (the starting point of the funnel)
uwall: UPPER_WALLS ARG=pp.proj AT=3.7 KAPPA=20000.0            # Upper Wall (the ending point of the funnel)

####################################
########### CALCULATE FUNNEL #######
# Returns the radius of the funnel
# at the current value of the cv
####################################
MATHEVAL ...
    LABEL=wall_center
    ARG=pp.proj,s_cent,beta_cent,wall_width,wall_buffer
    VAR=s,sc,b,h,f
    FUNC=h*(1./(1.+exp(b*(s-sc))))+f
    PERIODIC=NO
... MATHEVAL

################################
##### POTENTIAL_PARAMETERS #####
################################
scaling: CONSTANT VALUES=1.0
spring: CONSTANT VALUES=10000.0

################################
####### DEFINE_POTENTIAL #######
################################
MATHEVAL ...
    LABEL=wall_bias
    ARG=pp.ext,spring,wall_center,scaling
    VAR=z,k,zc,sf
    FUNC=step(z-zc)*k*(z-zc)*(z-zc)/(sf*sf)
    PERIODIC=NO
... MATHEVAL
finalbias: BIASVALUE ARG=wall_bias

#################################
######## DEFINE_OPES_EXPLORE ####
#################################

ene: ENERGY

ecv: ECV_MULTITHERMAL ARG=ene TEMP_MAX=370
opesX: OPES_EXPANDED ARG=ecv.* FILE=DeltaFs.data PACE=2000 

OPES_METAD_EXPLORE ...
  LABEL=opes
  ARG=pp.proj,cmap
  SIGMA=0.02,0.11
  FILE=Kernels.data
  STATE_RFILE=compressed.Kernels
  STATE_WFILE=compressed.Kernels
  PACE=20000
  BARRIER=30
... OPES_METAD_EXPLORE

OPES_METAD_EXPLORE ...
  LABEL=opesNP1
  ARG=NP1,lig_torsion1,lig_torsion2
  SIGMA=0.25,3.04,0.13
  FILE=KernelsNP1.data
  STATE_RFILE=compressed.KernelsNP1
  STATE_WFILE=compressed.KernelsNP1
  PACE=40000
  BARRIER=3
... OPES_METAD_EXPLORE

OPES_METAD_EXPLORE ...
  LABEL=opesNP2
  ARG=NP2,lig_torsion1,lig_torsion2
  SIGMA=0.07,3.04,0.13
  FILE=KernelsNP2.data
  STATE_RFILE=compressed.KernelsNP2
  STATE_WFILE=compressed.KernelsNP2
  PACE=40000
  BARRIER=3
... OPES_METAD_EXPLORE

OPES_METAD_EXPLORE ...
  LABEL=opesNP3
  ARG=NP3,lig_torsion1,lig_torsion2
  SIGMA=0.46,3.04,0.13
  FILE=KernelsNP3.data
  STATE_RFILE=compressed.KernelsNP3
  STATE_WFILE=compressed.KernelsNP3
  PACE=40000
  BARRIER=3
... OPES_METAD_EXPLORE

OPES_METAD_EXPLORE ...
  LABEL=opesNP4
  ARG=NP4,lig_torsion1,lig_torsion2
  SIGMA=0.07,3.04,0.13
  FILE=KernelsNP4.data
  STATE_RFILE=compressed.KernelsNP4
  STATE_WFILE=compressed.KernelsNP4
  PACE=40000
  BARRIER=3
... OPES_METAD_EXPLORE

OPES_METAD_EXPLORE ...
  LABEL=opesNG1
  ARG=NG1,lig_torsion1,lig_torsion2
  SIGMA=0.11,3.04,0.13
  FILE=KernelsNG1.data
  STATE_RFILE=compressed.KernelsNG1
  STATE_WFILE=compressed.KernelsNG1
  PACE=40000
  BARRIER=3
... OPES_METAD_EXPLORE

OPES_METAD_EXPLORE ...
  LABEL=opesNG2
  ARG=NG2,lig_torsion1,lig_torsion2
  SIGMA=0.08,3.04,0.13
  FILE=KernelsNG2.data
  STATE_RFILE=compressed.KernelsNG2
  STATE_WFILE=compressed.KernelsNG2
  PACE=40000
  BARRIER=3
... OPES_METAD_EXPLORE

PRINT ARG=* STRIDE=500 FILE=COLVAR FMT=%8.4f