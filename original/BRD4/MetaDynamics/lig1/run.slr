#!/bin/bash -l
#SBATCH --job-name="metad1"
#SBATCH --time=168:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-core=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=6
#SBATCH --partition=normal
#SBATCH --constraint=gpu
#SBATCH --hint=nomultithread

export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK
export CRAY_CUDA_MPS=1

source $HOME/spack/share/spack/setup-env.sh
# activate daint spack configuration
module load daint-gpu
module load spack-config
spack env activate gromacs-plumed

# METAD 
if [ ! -e run0/run.tpr ]; then
    srun gmx_mpi grompp -f prod.mdp -p top.top -c npt2.gro -o run0/run.tpr -n index.ndx -maxwarn 100 #-t run$i/run.cpt
fi

if [ ! -e run0/run.gro ]; then
  srun gmx_mpi mdrun -deffnm run -plumed ./plumed.dat -pin on -cpi -maxh 167.5
fi

sed -i "s/#RESTART/RESTART/g" run0/plumed.dat

# Resubmit script if unfinished
if [ ! -e run0/run.gro ]; then

	sbatch run.slr

fi

