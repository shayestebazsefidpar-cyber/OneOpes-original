integrator      = md
dt              = 0.002
nsteps          = 50000        ; 100 ps
nstxout         = 0
nstvout         = 0
nstenergy       = 500
nstlog          = 500

continuation    = no
constraint_algorithm = lincs
constraints     = h-bonds

cutoff-scheme   = Verlet
coulombtype     = PME
rcoulomb        = 1.0
rvdw            = 1.0
pbc             = xyz
DispCorr        = EnerPres

tcoupl          = V-rescale
tc-grps         = System
tau_t           = 0.1
ref_t           = 300

pcoupl          = no

gen_vel         = yes
gen_temp        = 300
gen_seed        = -1
